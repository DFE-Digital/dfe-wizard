digraph AssignMentorWizard {
rankdir = "LR";
fontname = "Arial";
fontsize = "11";
bgcolor = "#fafafa";
margin = "0.5";
ranksep = "1.0";
who_will_be_the_mentor [label = "Who Will Be The Mentor", shape = "ellipse", color = "#1976d2", fillcolor = "#e3f2fd", penwidth = "2.5"];
can_receive_mentor_training [label = "Can Receive Mentor Training", color = "#546e7a", fillcolor = "#eceff1", penwidth = "1.5"];
which_lead_provider [label = "Which Lead Provider", color = "#546e7a", fillcolor = "#eceff1", penwidth = "1.5"];
confirmation [label = "Confirmation", shape = "ellipse", color = "#388e3c", fillcolor = "#e8f5e9", penwidth = "2.5"];
  who_will_be_the_mentor -> can_receive_mentor_training [style = "bold", color = "#222222", penwidth = "1.5", arrowsize = "1.5"];
  which_lead_provider -> confirmation [style = "bold", color = "#222222", penwidth = "1.5", arrowsize = "1.5"];
  can_receive_mentor_training -> which_lead_provider [label = "LP provides?", color = "#388e3c", fontcolor = "#388e3c", penwidth = "2.5", style = "bold"];
  can_receive_mentor_training -> confirmation [label = "Else", color = "#d32f2f", fontcolor = "#d32f2f", penwidth = "2.5", style = "dashed"];
}
