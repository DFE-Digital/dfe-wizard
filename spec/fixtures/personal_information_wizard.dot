digraph PersonalInformationWizard {
rankdir = "LR";
fontname = "Arial";
fontsize = "11";
bgcolor = "#fafafa";
margin = "0.5";
ranksep = "1.0";
name_and_date_of_birth [label = "Name And Date Of Birth", shape = "ellipse", color = "#1976d2", fillcolor = "#e3f2fd", penwidth = "2.5"];
nationality [label = "Nationality", color = "#546e7a", fillcolor = "#eceff1", penwidth = "1.5"];
right_to_work_or_study [label = "Right To Work Or Study", color = "#546e7a", fillcolor = "#eceff1", penwidth = "1.5"];
immigration_status [label = "Immigration Status", color = "#546e7a", fillcolor = "#eceff1", penwidth = "1.5"];
review [label = "Review", shape = "ellipse", color = "#388e3c", fillcolor = "#e8f5e9", penwidth = "2.5"];
  name_and_date_of_birth -> nationality [style = "bold", color = "#222222", penwidth = "1.5", arrowsize = "1.5"];
  immigration_status -> review [style = "bold", color = "#222222", penwidth = "1.5", arrowsize = "1.5"];
  nationality -> right_to_work_or_study [label = "Non-UK/Non-Irish", color = "#388e3c", fontcolor = "#388e3c", penwidth = "2.5", style = "bold"];
  nationality -> review [label = "Else", color = "#d32f2f", fontcolor = "#d32f2f", penwidth = "2.5", style = "dashed"];
  right_to_work_or_study -> immigration_status [label = "Right to work or study?", color = "#388e3c", fontcolor = "#388e3c", penwidth = "2.5", style = "bold"];
  right_to_work_or_study -> review [label = "Else", color = "#d32f2f", fontcolor = "#d32f2f", penwidth = "2.5", style = "dashed"];
}
