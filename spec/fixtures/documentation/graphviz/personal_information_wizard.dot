digraph Personal_information_wizard {
  rankdir=LR;
  bgcolor="#ffffff";
  node [shape=box, style="rounded,filled", fillcolor="#e8f4f8", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  name_and_date_of_birth [label="Name And Date Of Birth"];
  nationality [label="Nationality"];
  right_to_work_or_study [label="Right To Work Or Study"];
  immigration_status [label="Immigration Status"];
  review [label="Review"];
  name_and_date_of_birth -> nationality [style=solid];
  immigration_status -> review [style=solid];
  nationality -> right_to_work_or_study [label="Non-UK/Non-Irish\nyes", style=dashed, color=blue];
  nationality -> review [label="Non-UK/Non-Irish\nno", style=dashed, color=blue];
  right_to_work_or_study -> immigration_status [label="Right to work or study?\nyes", style=dashed, color=blue];
  right_to_work_or_study -> review [label="Right to work or study?\nno", style=dashed, color=blue];
}
