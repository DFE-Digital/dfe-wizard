<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="UTF-8">

    <title>DfE Wizard - GOV.UK</title>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="govuk-template__body">
    <%= govuk_skip_link %>

    <%= govuk_header homepage_url: "https://www.gov.uk", classes: ["app-header--wide-logo", "govuk-header--full-width-border", "govuk-header--black"] %>

    <%= govuk_service_navigation(service_name: 'DfE Wizard docs', service_url: root_path) do |service_navigation| %>
      <%= service_navigation.with_navigation_item text: 'Wizards', href: '/' %>
    <% end %>

    <div class="govuk-width-container">
      <%= yield :before_content %>
      <main class="govuk-main-wrapper" id="main-content" role="main">
        <% if flash[:success] %>
          <%= govuk_notification_banner(
            title_text: "Success",
            success: true,
            title_id: "success-message",
            html_attributes: { role: "alert" },
          ) do |notification_banner| %>
            <% notification_banner.with_heading(text: flash[:success]) %>
          <% end %>
        <% end %>

       <%= yield %>
      </main>
    </div>
  </body>
</html>
