<% content_for :page_title, "Peter Davison can receive mentor training" %>

<%= govuk_back_link href: @wizard.previous_step_path || wizards_path %>

<h1 class="govuk-heading-l">Peter Davison can receive mentor training</h1>

<p class="govuk-body">Our records show that
  Peter Davison can get up to 20 hours of ECTE mentor training as your school is working with
  a DfE-funded training provider.</p>

<p class="govuk-body">We'll pass on their details to
  DfE Training Provider
  who will contact them to arrange the training.</p>
<%= form_with(model: @wizard.current_step, url: @wizard.current_step_path, scope: :can_receive_mentor_training) do %>
  <%= button_tag "Continue",
        type: "submit",
        name: "can_receive_mentor_training[lp_will_provide]",
        value: "yes",
        class: "govuk-button" %>

  <p class="govuk-body">
    <%= button_tag "DfE Training Provider will not be providing mentor training to Peter Davison",
          type: "submit",
          name: "can_receive_mentor_training[lp_will_provide]",
          value: "no",
          class: "govuk-link-button" %>
  </p>
<% end %>

