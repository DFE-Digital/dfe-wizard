<% content_for :page_title, "What is your UK immigration status?" %>

<%= govuk_back_link href: @wizard.previous_step_path || wizards_path %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      What is your UK immigration status?
    </h1>

    <%= form_with model: @wizard.current_step, url: @wizard.current_step_path do |form| %>
      <%= form.govuk_error_summary %>

      <%= form.govuk_radio_buttons_fieldset :status, legend: { text: "Select your immigration status" } do %>
        <%= form.govuk_radio_button :status, "Skilled Worker visa", label: { text: "Skilled Worker visa" } %>
        <%= form.govuk_radio_button :status, "Student visa", label: { text: "Student visa" } %>
        <%= form.govuk_radio_button :status, "Global Talent visa", label: { text: "Global Talent visa" } %>
        <%= form.govuk_radio_button :status, "Youth Mobility Scheme visa", label: { text: "Youth Mobility Scheme visa" } %>
        <%= form.govuk_radio_button :status, "Family visa", label: { text: "Family visa" } %>
        <%= form.govuk_radio_button :status, "EU Settlement Scheme (settled status)", label: { text: "EU Settlement Scheme (settled status)" } %>
        <%= form.govuk_radio_button :status, "EU Settlement Scheme (pre-settled status)", label: { text: "EU Settlement Scheme (pre-settled status)" } %>
        <%= form.govuk_radio_button :status, "Indefinite Leave to Remain", label: { text: "Indefinite Leave to Remain" } %>
        <%= form.govuk_radio_button :status, "Other", label: { text: "Other" }, reveal: -> {
          form.govuk_text_field :other_status, label: { text: "Please specify your immigration status" }
        } %>
      <% end %>

      <%= form.govuk_submit "Continue" %>
    <% end %>
  </div>
</div>
