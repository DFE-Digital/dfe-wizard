<% content_for :page_title, "Check your answers" %>

<%= govuk_back_link href: @wizard.previous_step_path %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Check your answers</h1>

    <%= govuk_summary_list do |summary_list| %>
      <% @wizard.summary_steps.each do |step| %>
        <% step.attributes.each do |label, value| %>
          <%= summary_list.with_row do |row| %>
            <%=  row.with_key(text: step.class.human_attribute_name(label)) %>

            <% if value.is_a?(Date) %>
              <%= row.with_value(text: value.to_fs(:govuk_date)) %>
            <% else %>
              <%= row.with_value(text: Array(value).compact_blank.map(&:humanize).join(', ')) %>
            <% end %>
            <%= row.with_action(
                  text: "Change",
                  href: @wizard.resolve_step_path(step.class.model_name.param_key.to_sym),
                  visually_hidden_text: label.humanize
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= button_to "Confirm and submit", "#", method: :post, class: "govuk-button" %>
  </div>
</div>
