<% content_for :page_title, "Do you have the right to work or study in the UK?" %>

<%= govuk_back_link href: @wizard.previous_step_path || wizards_path %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      Do you have the right to work or study in the UK?
    </h1>

    <%= form_with model: @wizard.current_step, url: @wizard.current_step_path do |form| %>
      <%= form.govuk_error_summary %>

      <%= form.govuk_radio_buttons_fieldset :right_to_work_or_study, legend: { text: 'Right to work or study?' } do %>
        <%= form.govuk_radio_button :right_to_work_or_study, "yes", label: { text: "Yes" } %>
        <%= form.govuk_radio_button :right_to_work_or_study, "no",  label: { text: "No"  } %>
      <% end %>

      <%= form.govuk_submit "Continue" %>
    <% end %>
  </div>
</div>
